<cem:li>Forme interrogative</cem:li>
<cem:li>L'ordre des mots</cem:li>
<cem:li>Phrases affirmatives</cem:li>
<cem:li>Phrases négatives</cem:li>
<cem:li>Phrases interrogatives</cem:li>
</cem:keyword>
